# Put this file in the DOCUMENT ROOT of the OLD site
# (same folder as the old index.php / index.html).
# Place these rules ABOVE any "# BEGIN WordPress" block.

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Do not redirect the Vercel host itself
RewriteCond %{HTTP_HOST} !^eg-tree-services-ten\.vercel\.app$ [NC]

# Send every request to the new Vercel site
RewriteRule ^(.*)$ https://eg-tree-services-ten.vercel.app/$1 [R=302,L,QSA]
</IfModule>

# Fallback if mod_rewrite is off
<IfModule !mod_rewrite.c>
Redirect 302 / https://eg-tree-services-ten.vercel.app/
</IfModule>
